# Gemini API key. Get one at https://aistudio.google.com/apikey
# Server-side only. Never send to the browser or commit to git.
GEMINI_API_KEY=your_key_here

# Model ID. See https://ai.google.dev/gemini-api/docs/models
# Current verified default: gemini-3.5-flash-lite (confirmed via live test, 2026-09-22)
GEMINI_MODEL=gemini-3.5-flash-lite

# Hugging Face token for ML.ENERGY benchmark data (Apache-2.0 licensed)
# Get one at https://huggingface.co/settings/tokens
# Required only for Phase 7 surrogate training. Leave blank to skip.
HF_TOKEN=

# Maximum Gemini calls per session (budget guard)
GEMINI_MAX_CALLS_PER_SESSION=20
