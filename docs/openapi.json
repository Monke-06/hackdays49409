{
  "openapi": "3.1.0",
  "info": {
    "title": "Sustainable AI Lifecycle Auditor API",
    "description": "Estimates lifecycle energy, carbon, and hardware footprint of AI systems.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Health Check",
        "description": "Service health and capability reporting.",
        "operationId": "health_check_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/regions": {
      "get": {
        "summary": "Get Regions",
        "description": "List all supported geographical and cloud regions for grid carbon intensity.",
        "operationId": "get_regions_api_v1_regions_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array",
                  "title": "Response Get Regions Api V1 Regions Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/presets": {
      "get": {
        "summary": "Get Metadata And Presets",
        "description": "Returns available models, hardware options, geographical regions,\nand preset scenarios (inputs only) so the frontend hardcodes nothing.",
        "operationId": "get_metadata_and_presets_api_v1_presets_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetadataResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/meta": {
      "get": {
        "summary": "Get Metadata And Presets",
        "description": "Returns available models, hardware options, geographical regions,\nand preset scenarios (inputs only) so the frontend hardcodes nothing.",
        "operationId": "get_metadata_and_presets_api_v1_meta_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetadataResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ledger": {
      "post": {
        "summary": "Calculate Ledger",
        "description": "Compute dual lifecycle ledgers (operational and full_lifecycle)\nfor a given AI system inventory.",
        "operationId": "calculate_ledger_api_v1_ledger_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LedgerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LedgerResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/claims/check": {
      "post": {
        "summary": "Check Efficiency Claim",
        "description": "Audit an efficiency claim against baseline and subject ledgers\nusing the deterministic multi-tier verification cascade.",
        "operationId": "check_efficiency_claim_api_v1_claims_check_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClaimToLedgerMapping"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Verdict"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/claims/extract": {
      "post": {
        "summary": "Extract Claim",
        "description": "Extract a structured Claim object from free-text marketing copy,\nresearch papers, or model cards.",
        "operationId": "extract_claim_api_v1_claims_extract_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtractClaimRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Claim"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recommend": {
      "post": {
        "summary": "Recommend Architectures",
        "description": "Generate alternative architectures, evaluate full lifecycle ledgers,\nfilter constraints, and compute Pareto frontier.",
        "operationId": "recommend_architectures_api_v1_recommend_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecommendRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParetoResult"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountingMethod": {
        "type": "string",
        "enum": [
          "location",
          "market"
        ],
        "title": "AccountingMethod"
      },
      "AccuracySource": {
        "type": "string",
        "enum": [
          "user_sample_eval",
          "cited_published_delta",
          "not_available"
        ],
        "title": "AccuracySource",
        "description": "How the accuracy estimate for a candidate was obtained."
      },
      "Boundary": {
        "type": "string",
        "enum": [
          "operational",
          "full_lifecycle"
        ],
        "title": "Boundary"
      },
      "BoundaryStated": {
        "properties": {
          "includes_training": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Includes Training"
          },
          "includes_embodied": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Includes Embodied"
          },
          "includes_retraining": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Includes Retraining"
          },
          "accounting": {
            "type": "string",
            "enum": [
              "location",
              "market",
              "unspecified"
            ],
            "title": "Accounting",
            "default": "unspecified"
          }
        },
        "type": "object",
        "title": "BoundaryStated"
      },
      "Claim": {
        "properties": {
          "claim_text": {
            "type": "string",
            "title": "Claim Text"
          },
          "metric": {
            "type": "string",
            "enum": [
              "energy",
              "carbon",
              "latency",
              "cost"
            ],
            "title": "Metric"
          },
          "claimed_change_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Claimed Change Pct"
          },
          "baseline_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseline Ref"
          },
          "subject_ref": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Subject Ref"
          },
          "boundary_stated": {
            "$ref": "#/components/schemas/BoundaryStated"
          },
          "hardware": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Hardware"
          },
          "region": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Region"
          },
          "accuracy_change_reported": {
            "type": "boolean",
            "title": "Accuracy Change Reported",
            "default": false
          },
          "accuracy_change_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Accuracy Change Pct"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "vendor",
              "paper",
              "model_card",
              "blog",
              "unknown"
            ],
            "title": "Source Type",
            "default": "unknown"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "extraction_source": {
            "type": "string",
            "enum": [
              "gemini",
              "rules_fallback",
              "user_specified"
            ],
            "title": "Extraction Source",
            "default": "user_specified"
          }
        },
        "type": "object",
        "required": [
          "claim_text",
          "metric",
          "boundary_stated"
        ],
        "title": "Claim",
        "description": "A structured efficiency claim extracted from free text or a model card.\n\nFields left None mean the information was absent or ambiguous in the source.\nNever guess missing boundary fields: leave them unspecified / None."
      },
      "ClaimToLedgerMapping": {
        "properties": {
          "claim": {
            "$ref": "#/components/schemas/Claim"
          },
          "baseline_ledger": {
            "$ref": "#/components/schemas/LifecycleLedger-Input"
          },
          "subject_ledger": {
            "$ref": "#/components/schemas/LifecycleLedger-Input"
          },
          "baseline_ledger_full": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LifecycleLedger-Input"
              },
              {
                "type": "null"
              }
            ]
          },
          "subject_ledger_full": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LifecycleLedger-Input"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "claim",
          "baseline_ledger",
          "subject_ledger"
        ],
        "title": "ClaimToLedgerMapping",
        "description": "User-supplied mapping that links a Claim to computed LifecycleLedgers.\n\nCan supply both operational ledgers (baseline_ledger, subject_ledger)\nand full-lifecycle ledgers (baseline_ledger_full, subject_ledger_full).\nIf full-lifecycle ledgers are omitted, the checker uses baseline_ledger\nand subject_ledger under their native boundary."
      },
      "ExtractClaimRequest": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "ExtractClaimRequest"
      },
      "GPUSpec": {
        "properties": {
          "model": {
            "type": "string",
            "title": "Model",
            "description": "GPU model string, e.g. 'NVIDIA A100 80GB SXM4'."
          },
          "count": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Count"
          },
          "tdp_w": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tdp W",
            "description": "Thermal Design Power in Watts. If None, looked up from reference table. User-supplied value takes precedence."
          }
        },
        "type": "object",
        "required": [
          "model",
          "count"
        ],
        "title": "GPUSpec"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HardwareOption": {
        "properties": {
          "model": {
            "type": "string",
            "title": "Model"
          },
          "tdp_w": {
            "type": "number",
            "title": "Tdp W"
          },
          "vram_gb": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Vram Gb"
          }
        },
        "type": "object",
        "required": [
          "model",
          "tdp_w"
        ],
        "title": "HardwareOption"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "gemini_available": {
            "type": "boolean",
            "title": "Gemini Available"
          },
          "gemini_model": {
            "type": "string",
            "title": "Gemini Model"
          },
          "regions_count": {
            "type": "integer",
            "title": "Regions Count"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "gemini_available",
          "gemini_model",
          "regions_count"
        ],
        "title": "HealthResponse"
      },
      "InferenceConfig": {
        "properties": {
          "gpu": {
            "$ref": "#/components/schemas/GPUSpec"
          },
          "runtime_hours": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Runtime Hours",
            "description": "Operational inference runtime hours (default 8760.0 = 1 year).",
            "default": 8760.0
          },
          "batch_size": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Batch Size",
            "default": 1
          },
          "requests_per_day": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Requests Per Day"
          },
          "avg_tokens_per_request": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Avg Tokens Per Request",
            "default": 512
          },
          "p95_latency_limit_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "P95 Latency Limit Ms",
            "description": "Hard latency constraint. Candidates exceeding this are excluded from Pareto."
          }
        },
        "type": "object",
        "required": [
          "gpu",
          "requests_per_day"
        ],
        "title": "InferenceConfig"
      },
      "LedgerAssumptions": {
        "properties": {
          "grid_intensity_gco2_per_kwh": {
            "$ref": "#/components/schemas/Quantity"
          },
          "pue": {
            "type": "number",
            "exclusiveMinimum": 1.0,
            "title": "Pue",
            "description": "Power Usage Effectiveness (>1.0)."
          },
          "pue_source": {
            "type": "string",
            "title": "Pue Source",
            "description": "Where this PUE value came from."
          },
          "utilization": {
            "type": "number",
            "maximum": 1.0,
            "exclusiveMinimum": 0.0,
            "title": "Utilization",
            "description": "Fraction of peak TDP drawn."
          },
          "utilization_source": {
            "type": "string",
            "title": "Utilization Source"
          },
          "hardware_lifetime_years": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Hardware Lifetime Years"
          },
          "hardware_lifetime_source": {
            "type": "string",
            "title": "Hardware Lifetime Source"
          },
          "region": {
            "type": "string",
            "title": "Region"
          },
          "accounting": {
            "$ref": "#/components/schemas/AccountingMethod"
          },
          "monte_carlo_n_samples": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Monte Carlo N Samples",
            "default": 1000
          },
          "monte_carlo_seed": {
            "type": "integer",
            "title": "Monte Carlo Seed",
            "default": 42
          },
          "note": {
            "type": "string",
            "title": "Note",
            "default": "All ranges labeled 'under stated assumptions'. Changing any assumption can move results outside this range."
          }
        },
        "type": "object",
        "required": [
          "grid_intensity_gco2_per_kwh",
          "pue",
          "pue_source",
          "utilization",
          "utilization_source",
          "hardware_lifetime_years",
          "hardware_lifetime_source",
          "region",
          "accounting"
        ],
        "title": "LedgerAssumptions",
        "description": "Every assumption that can change a number is documented here.\nThe UI shows this block alongside any result so the user can audit it."
      },
      "LedgerEngineConfig": {
        "properties": {
          "pue": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pue"
          },
          "hardware_lifetime_years": {
            "type": "number",
            "title": "Hardware Lifetime Years",
            "default": 4.0
          },
          "utilization": {
            "type": "number",
            "title": "Utilization",
            "default": 1.0
          },
          "accounting": {
            "$ref": "#/components/schemas/AccountingMethod",
            "default": "location"
          },
          "n_mc_samples": {
            "type": "integer",
            "title": "N Mc Samples",
            "default": 1000
          },
          "mc_seed": {
            "type": "integer",
            "title": "Mc Seed",
            "default": 42
          },
          "requests_per_day": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Requests Per Day"
          }
        },
        "type": "object",
        "title": "LedgerEngineConfig",
        "description": "Overridable assumptions for the ledger engine.\nDefaults match the recommended values from their respective sources."
      },
      "LedgerRequest": {
        "properties": {
          "inventory": {
            "$ref": "#/components/schemas/SystemInventory"
          },
          "config": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LedgerEngineConfig"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "inventory"
        ],
        "title": "LedgerRequest"
      },
      "LedgerResponse": {
        "properties": {
          "operational": {
            "$ref": "#/components/schemas/LifecycleLedger-Output"
          },
          "full_lifecycle": {
            "$ref": "#/components/schemas/LifecycleLedger-Output"
          }
        },
        "type": "object",
        "required": [
          "operational",
          "full_lifecycle"
        ],
        "title": "LedgerResponse"
      },
      "LifecycleLedger-Input": {
        "properties": {
          "boundary": {
            "$ref": "#/components/schemas/Boundary"
          },
          "training": {
            "$ref": "#/components/schemas/Quantity"
          },
          "inference": {
            "$ref": "#/components/schemas/Quantity"
          },
          "embodied_hardware": {
            "$ref": "#/components/schemas/Quantity"
          },
          "retraining": {
            "$ref": "#/components/schemas/Quantity"
          },
          "storage": {
            "$ref": "#/components/schemas/Quantity"
          },
          "network": {
            "$ref": "#/components/schemas/Quantity"
          },
          "energy_kwh": {
            "$ref": "#/components/schemas/Quantity"
          },
          "per_request": {
            "$ref": "#/components/schemas/Quantity"
          },
          "assumptions": {
            "$ref": "#/components/schemas/LedgerAssumptions"
          },
          "schema_version": {
            "type": "integer",
            "title": "Schema Version",
            "default": 1
          }
        },
        "type": "object",
        "required": [
          "boundary",
          "training",
          "inference",
          "embodied_hardware",
          "retraining",
          "storage",
          "network",
          "energy_kwh",
          "per_request",
          "assumptions"
        ],
        "title": "LifecycleLedger",
        "description": "Full or operational carbon/energy ledger for one AI system configuration.\n\nAll component fields are in kg CO2e. energy_kwh is in kWh.\nper_request is in kg CO2e per request."
      },
      "LifecycleLedger-Output": {
        "properties": {
          "boundary": {
            "$ref": "#/components/schemas/Boundary"
          },
          "training": {
            "$ref": "#/components/schemas/Quantity"
          },
          "inference": {
            "$ref": "#/components/schemas/Quantity"
          },
          "embodied_hardware": {
            "$ref": "#/components/schemas/Quantity"
          },
          "retraining": {
            "$ref": "#/components/schemas/Quantity"
          },
          "storage": {
            "$ref": "#/components/schemas/Quantity"
          },
          "network": {
            "$ref": "#/components/schemas/Quantity"
          },
          "energy_kwh": {
            "$ref": "#/components/schemas/Quantity"
          },
          "per_request": {
            "$ref": "#/components/schemas/Quantity"
          },
          "assumptions": {
            "$ref": "#/components/schemas/LedgerAssumptions"
          },
          "schema_version": {
            "type": "integer",
            "title": "Schema Version",
            "default": 1
          },
          "total_carbon": {
            "$ref": "#/components/schemas/Quantity",
            "description": "Total carbon footprint for this boundary in kgCO2e.",
            "readOnly": true
          },
          "total_energy": {
            "$ref": "#/components/schemas/Quantity",
            "description": "Total energy consumption in kWh.",
            "readOnly": true
          }
        },
        "type": "object",
        "required": [
          "boundary",
          "training",
          "inference",
          "embodied_hardware",
          "retraining",
          "storage",
          "network",
          "energy_kwh",
          "per_request",
          "assumptions",
          "total_carbon",
          "total_energy"
        ],
        "title": "LifecycleLedger",
        "description": "Full or operational carbon/energy ledger for one AI system configuration.\n\nAll component fields are in kg CO2e. energy_kwh is in kWh.\nper_request is in kg CO2e per request."
      },
      "MetadataResponse": {
        "properties": {
          "models": {
            "items": {
              "$ref": "#/components/schemas/ModelPreset"
            },
            "type": "array",
            "title": "Models"
          },
          "hardware": {
            "items": {
              "$ref": "#/components/schemas/HardwareOption"
            },
            "type": "array",
            "title": "Hardware"
          },
          "regions": {
            "items": {
              "$ref": "#/components/schemas/RegionOption"
            },
            "type": "array",
            "title": "Regions"
          },
